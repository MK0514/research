def build_flowfield_image(mesh: MeshData, values: np.ndarray, nx: int = 320, ny: int = 180):
    x0 = float(mesh.profile_x.min())
    x1 = float(mesh.profile_x.max())
    rmax = float(mesh.profile_r.max())
    L = max(x1 - x0, 1.0)

    x_min = x0 - 0.15 * L
    x_max = x1 + 0.80 * L
    r_lim = min(float(np.max(mesh.cell_centers[:, 1])), max(3.5 * rmax, 1.8 * rmax + 0.25 * L))

    xc = mesh.cell_centers[:, 0]
    rc = mesh.cell_centers[:, 1]
    mask = (xc >= x_min) & (xc <= x_max) & (rc >= 0.0) & (rc <= r_lim)
    xc = xc[mask]
    rc = rc[mask]
    vv = values[mask]

    x_edges = np.linspace(x_min, x_max, nx + 1)
    r_edges = np.linspace(0.0, r_lim, ny + 1)
    weighted, _, _ = np.histogram2d(xc, rc, bins=[x_edges, r_edges], weights=vv)
    counts, _, _ = np.histogram2d(xc, rc, bins=[x_edges, r_edges])
    field = weighted / np.maximum(counts, 1.0)

    # Fill sparse bins with nearest streamwise average to avoid checkerboard holes.
    row_mean = np.divide(weighted.sum(axis=1), np.maximum(counts.sum(axis=1), 1.0))
    for i in range(field.shape[0]):
        empty = counts[i] < 1.0
        if np.any(empty):
            field[i, empty] = row_mean[i]

    x_cent = 0.5 * (x_edges[:-1] + x_edges[1:])
    r_cent = 0.5 * (r_edges[:-1] + r_edges[1:])
    body_r = np.interp(x_cent, mesh.profile_x, mesh.profile_r, left=0.0, right=0.0)
    body_mask = r_cent[None, :] < body_r[:, None]
    field = np.where(body_mask, np.nan, field)
    return x_cent, r_cent, field.T


def plot_flowfield(mesh: MeshData, result: SolverResult, var_name: str, case_color: str, mach: float) -> go.Figure:
    mach_field = np.sqrt(result.primitive["u"] ** 2 + result.primitive["v"] ** 2) / np.maximum(result.primitive["a"], 1.0)
    cp_field = (result.primitive["p"] - np.median(result.primitive["p"])) / (
        0.5 * np.median(result.primitive["rho"]) * max(np.median(result.primitive["u"]) ** 2, 1.0)
    )
    field = {
        "P": result.primitive["p"],
        "rho": result.primitive["rho"],
        "T": result.primitive["T"],
        "Mach": mach_field,
        "Cp": cp_field,
    }[var_name]
    xg, rg, img = build_flowfield_image(mesh, field)
    fig = go.Figure()
    fig.add_trace(
        go.Heatmap(
            x=xg,
            y=rg,
            z=img,
            colorscale="Turbo",
            colorbar=dict(title=var_name),
            zsmooth="best",
            name=var_name,
            showscale=True,
        )
    )
    fig.add_trace(
        go.Heatmap(
            x=xg,
            y=-rg,
            z=np.flipud(img),
            colorscale="Turbo",
            zsmooth="best",
            showscale=False,
            hoverinfo="skip",
            name=f"{var_name} (-)",
        )
    )
    fig.add_trace(
        go.Scatter(
            x=mesh.profile_x,
            y=-mesh.profile_r,
            mode="lines",
            line=dict(color=case_color, width=2.5),
            name="body (-)",
            showlegend=False,
        )
    )
    levels = np.linspace(np.nanpercentile(img, 10), np.nanpercentile(img, 90), 8)
    fig.add_trace(
        go.Contour(
            x=xg,
            y=rg,
            z=img,
            contours=dict(start=float(levels[0]), end=float(levels[-1]), size=float((levels[-1] - levels[0]) / max(len(levels) - 1, 1))),
            showscale=False,
            line=dict(width=1.0, color="rgba(255,255,255,0.30)"),
            hoverinfo="skip",
        )
    )
    fig.add_trace(
        go.Contour(
            x=xg,
            y=-rg,
            z=np.flipud(img),
            contours=dict(start=float(levels[0]), end=float(levels[-1]), size=float((levels[-1] - levels[0]) / max(len(levels) - 1, 1))),
            showscale=False,
            line=dict(width=1.0, color="rgba(255,255,255,0.30)"),
            hoverinfo="skip",
            showlegend=False,
        )
    )
    fig.update_layout(
        title=f"▌ 유동장 분포 ({var_name}) | Mach={mach:.2f} | mesh-based field map",
        template="plotly_dark",
        height=520,
        xaxis_title="x [m]",
        yaxis_title="r [m]",
        yaxis=dict(scaleanchor="x", scaleratio=1),
    )
    return fig


def plot_residual_history(result: SolverResult, title: str) -> go.Figure:
    fig = go.Figure(
        data=[
            go.Scatter(
                x=np.arange(1, len(result.residual_history) + 1),
                y=result.residual_history,
                mode="lines+markers",
                line=dict(color="#4FC3F7", width=2.5),
            )
        ]
    )
    fig.update_layout(
        title=title,
        template="plotly_dark",
        height=300,
        xaxis_title="LU-SGS iteration",
        yaxis_title="L2 residual (continuity)",
        yaxis_type="log",
    )
    return fig


def render_results_bundle(bundle: Dict, flow_field_var: str, flow_rocket_name: str):
    atm_cond = bundle["atm_cond"]
    mach_arr = bundle["mach_arr"]
    selected_cases = bundle["selected_cases"]
    selected_meshes = bundle["selected_meshes"]
    single_results = bundle["single_results"]
    sweep_results = bundle["sweep_results"]
    M_single = bundle["M_single"]
    altitude = bundle["altitude"]
    est_runtime_s = bundle["estimated_runtime_s"]

    st.markdown('<div class="section-header">🌐 ISA 대기 조건 (해석 고도)</div>', unsafe_allow_html=True)
    c1, c2, c3, c4, c5 = st.columns(5)
    metric_card(c1, "고도", f"{altitude/1000:.1f}", "km")
    metric_card(c2, "온도 T", f"{atm_cond['T']:.1f}", "K")
    metric_card(c3, "압력 P", f"{atm_cond['P']/1000:.2f}", "kPa")
    metric_card(c4, "밀도 ρ", f"{atm_cond['rho']:.4f}", "kg/m³")
    metric_card(c5, "음속 a", f"{atm_cond['a']:.1f}", "m/s")

    st.markdown('<div class="section-header">📊 수치 해석 결과</div>', unsafe_allow_html=True)
    st.caption(f"예상 계산 시간(현재 설정 기준): 약 {est_runtime_s/60:.1f}분 ({est_runtime_s:.0f}초)")

    rows = []
    for name, mesh in selected_meshes.items():
        res = single_results[name]
        rows.append(
            {
                "발사체": name,
                "격자 노드 수": f"{res.mesh_points:,}",
                "제어체적 수": f"{res.n_cells:,}",
                "면(face) 수": f"{res.n_faces:,}",
                "계산 시간 [s]": f"{res.runtime_s:.2f}",
                f"CD (M={M_single:.2f})": f"{res.coeffs['CD_total']:.4f}",
                f"CN (M={M_single:.2f})": f"{res.coeffs['CN']:.4f}",
                f"Cm (M={M_single:.2f})": f"{res.coeffs['Cm']:.4f}",
            }
        )
    st.dataframe(pd.DataFrame(rows), use_container_width=True, hide_index=True)

    tabs = st.tabs(["📐 형상 프로파일", "📈 CD vs Mach", "🌈 유동장 분포", "🔵 항력 성분 분해", "🔄 안정성 계수", "📉 잔차"])

    with tabs[0]:
        st.plotly_chart(plot_rocket_profile(selected_meshes, selected_cases), use_container_width=True)
        st.caption("▲ 1.mesh.py의 body boundary를 직접 읽어 생성한 프로파일입니다.")

    with tabs[1]:
        fig_cd = plot_cd_vs_mach(mach_arr, sweep_results, selected_cases)
        st.plotly_chart(fig_cd, use_container_width=True)
        df_cd = pd.DataFrame({"Mach": mach_arr})
        for name, data in sweep_results.items():
            df_cd[f"{name}_CD"] = data["cd"]
        st.download_button("📥 CD 데이터 CSV 다운로드", df_cd.to_csv(index=False).encode(), "cd_vs_mach.csv", "text/csv")

    with tabs[2]:
        if flow_rocket_name in selected_meshes:
            flow_mesh = selected_meshes[flow_rocket_name]
            flow_res = single_results[flow_rocket_name]
            var_map = {"압력 P": "P", "밀도 ρ": "rho", "온도 T": "T", "마하수 M": "Mach", "압력계수 Cp": "Cp"}
            st.plotly_chart(
                plot_flowfield(flow_mesh, flow_res, var_map[flow_field_var], selected_cases[flow_rocket_name].color, M_single),
                use_container_width=True,
            )
            st.caption("▲ 셀 중심 primitive field를 축대칭으로 반사해 표시합니다.")

    with tabs[3]:
        cols = st.columns(min(3, len(selected_meshes)))
        for i, name in enumerate(selected_meshes):
            with cols[i % len(cols)]:
                st.plotly_chart(plot_cd_breakdown(single_results[name], f"{name} | CD 분해"), use_container_width=True)

    with tabs[4]:
        st.plotly_chart(plot_cn_cm_vs_mach(mach_arr, sweep_results, selected_cases), use_container_width=True)
        st.caption("▲ 축대칭 해석 한계를 고려해 CN/Cm은 CFD 축력과 slender-body proxy를 결합한 지표입니다.")

    with tabs[5]:
        cols = st.columns(min(3, len(selected_meshes)))
        for i, name in enumerate(selected_meshes):
            with cols[i % len(cols)]:
                st.plotly_chart(plot_residual_history(single_results[name], f"{name} | LU-SGS Residual"), use_container_width=True)


def main():
    st.markdown(
        """
        <div style='border: 1px solid #1A3A5A; border-radius: 8px; padding: 18px 24px;
                    background: linear-gradient(135deg, #050D1A, #0A1930); margin-bottom: 20px;'>
            <div style='font-family:"Share Tech Mono",monospace; font-size:22px;
                        color:#4FC3F7; letter-spacing:4px;'>
                🚀 발사체 CFD 시뮬레이터
            </div>
            <div style='font-family:"Rajdhani",sans-serif; font-size:14px;
                        color:#7AB3CC; margin-top:6px; letter-spacing:1px;'>
                1.mesh NPZ · Compressible RANS · k-ω SST · AUSM+ · LU-SGS
            </div>
        </div>
        """,
        unsafe_allow_html=True,
    )

    workdir = Path(__file__).resolve().parent
    mesh_cases = discover_mesh_cases(workdir)

    available_names = list(mesh_cases.keys())
    default_sel = [n for n in ["누리호 (KSLV-II)", "타우러스 2210", "팰컨 9 (Block 5)"] if n in mesh_cases]

    with st.sidebar:
        with st.form("solver_controls"):
            st.markdown('<div class="section-header">📐 해석 조건</div>', unsafe_allow_html=True)
            altitude = st.slider("고도 [m]", 0, 80000, 10000, 1000)
            M_single = st.slider("단일 마하수 (유동장/계수 조회)", 0.3, 5.0, 2.0, 0.1)
            n_mach = st.slider("마하 스윕 포인트 수", 3, 20, 6, 1)
            max_iter = st.slider("LU-SGS 반복 수", 4, 40, 12, 2)
            cfl = st.slider("LU-SGS CFL", 0.5, 8.0, 2.5, 0.5)

            st.markdown('<div class="section-header">🛸 분석 발사체 선택</div>', unsafe_allow_html=True)
            sel_rockets = st.multiselect("비교할 발사체", ["누리호 (KSLV-II)", "타우러스 2210", "팰컨 9 (Block 5)"], default=default_sel)

            st.markdown('<div class="section-header">🧩 메쉬 입력</div>', unsafe_allow_html=True)
            if not mesh_cases:
                st.error("1.mesh.py가 생성한 NPZ 메쉬를 찾지 못했습니다.")
            else:
                for name in ["누리호 (KSLV-II)", "타우러스 2210", "팰컨 9 (Block 5)"]:
                    if name in mesh_cases:
                        st.caption(f"{name}: `{Path(mesh_cases[name].path).name}`")

            st.markdown('<div class="section-header">🎨 시각화 설정</div>', unsafe_allow_html=True)
            flow_field_var = st.selectbox("유동장 시각화 변수", ["압력 P", "밀도 ρ", "온도 T", "마하수 M", "압력계수 Cp"])
            flow_rocket_name = st.selectbox("유동장 표시 발사체", available_names if available_names else ["없음"])
            run_btn = st.form_submit_button("▶ 시뮬레이션 실행", type="primary")

    if "last_run_bundle" not in st.session_state:
        st.session_state["last_run_bundle"] = None

    if not run_btn and st.session_state["last_run_bundle"] is None:
        st.markdown(
            """
            <div class="warning-box">
            ⓘ  현재 앱은 1.mesh.py가 만든 NPZ 메쉬를 읽어 CFD 계산을 수행합니다.<br>
            &nbsp;&nbsp;&nbsp;&nbsp;왼쪽 파라미터를 바꿔도 <strong>시뮬레이션 실행</strong> 전까지는 계산이 다시 시작되지 않습니다.
            </div>
            """,
            unsafe_allow_html=True,
        )
        return

    if not mesh_cases:
        st.stop()
    if not sel_rockets:
        st.error("발사체를 최소 1개 선택해주세요.")
        return

    if run_btn:
        selected_cases = {name: mesh_cases[name] for name in sel_rockets if name in mesh_cases}
        selected_meshes = {name: load_mesh(case.path, name) for name, case in selected_cases.items()}
        atm_cond = isa_atmosphere(altitude)
        mach_arr = np.linspace(max(0.3, min(0.8, M_single)), 5.0, n_mach)
        est_runtime_s = estimate_runtime_seconds(
            max(len(mesh.cell_nodes) for mesh in selected_meshes.values()),
            max_iter,
            n_mach,
            len(selected_meshes),
        )

        progress_bar = st.progress(0.0, text="계산 준비 중...")
        log_placeholder = st.empty()
        logs: List[str] = []

        def push_log(message: str):
            logs.append(message)
            log_placeholder.code("\n".join(logs[-12:]), language="text")

        st.markdown('<div class="section-header">📊 수치 해석 진행 로그</div>', unsafe_allow_html=True)
        push_log(f"예상 총 계산 시간: 약 {est_runtime_s/60:.1f}분 ({est_runtime_s:.0f}초)")

        base_cfg = SolverConfig(mach=M_single, altitude=altitude, cfl=cfl, max_iter=max_iter)
        single_results: Dict[str, SolverResult] = {}
        sweep_results: Dict[str, Dict[str, List[float]]] = {}
        total_units = len(selected_meshes) * max(max_iter + n_mach, 1)
        finished_units = 0

        for name, mesh in selected_meshes.items():
            push_log(f"[{name}] 단일 마하 해석 시작 | cells={len(mesh.cell_nodes):,} faces={len(mesh.faces_left):,}")

            def single_cb(message: str, frac: float, _name=name):
                overall = (finished_units + frac * max_iter) / total_units
                progress_bar.progress(min(overall, 1.0), text=message)
                push_log(message)

            single_results[name] = solve_case(mesh, base_cfg, progress_callback=single_cb)
            finished_units += max_iter
            push_log(f"[{name}] 단일 마하 해석 완료 | time={single_results[name].runtime_s:.2f}s")

            def sweep_cb(message: str, frac: float, _name=name):
                overall = (finished_units + frac * n_mach) / total_units
                progress_bar.progress(min(overall, 1.0), text=message)
                push_log(message)

            sweep_results[name] = run_mach_sweep(mesh, mach_arr, altitude, base_cfg, progress_callback=sweep_cb)
            finished_units += n_mach
            push_log(f"[{name}] 마하 스윕 완료")

        progress_bar.progress(1.0, text="계산 완료")
        push_log("모든 케이스 계산이 완료되었습니다.")

        st.session_state["last_run_bundle"] = {
            "atm_cond": atm_cond,
            "mach_arr": mach_arr,
            "selected_cases": selected_cases,
            "selected_meshes": selected_meshes,
            "single_results": single_results,
            "sweep_results": sweep_results,
            "M_single": M_single,
            "altitude": altitude,
            "estimated_runtime_s": est_runtime_s,
        }

    bundle = st.session_state["last_run_bundle"]
    if bundle is not None:
        render_results_bundle(bundle, flow_field_var, flow_rocket_name)

    with st.expander("📖 적용 수치기법 요약"):
        st.markdown(
            """
            - 지배 방정식: cell-centered finite-volume compressible RANS
            - 난류 모델: k-ω SST blended constants, eddy viscosity closure
            - 대류 플럭스: AUSM+ mass/pressure splitting
            - 점성항: Green-Gauss gradient + central viscous flux
            - 시간적분: local pseudo-time LU-SGS
            - 메쉬 입력: 1.mesh.py 생성 NPZ (`nodes`, `quad_cells`, `tri_cells`, `face_nodes`, `face_tag`)
            """
        )


if __name__ == "__main__":
    main()
