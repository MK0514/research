def isa_atmosphere(altitude_m: float) -> Dict[str, float]:
    g0 = 9.80665
    T0 = 288.15
    P0 = 101325.0
    h = float(altitude_m)

    if h < 11000.0:
        lapse = -0.0065
        T = T0 + lapse * h
        P = P0 * (T / T0) ** (-g0 / (R_AIR * lapse))
    elif h < 20000.0:
        T = 216.65
        P11 = P0 * (216.65 / T0) ** (-g0 / (R_AIR * (-0.0065)))
        P = P11 * np.exp(-g0 * (h - 11000.0) / (R_AIR * T))
    else:
        T = 216.65 + 0.001 * (h - 20000.0)
        T11 = 216.65
        P11 = P0 * (T11 / T0) ** (-g0 / (R_AIR * (-0.0065)))
        P20 = P11 * np.exp(-g0 * 9000.0 / (R_AIR * T11))
        P = P20 * (T / T11) ** (-g0 / (R_AIR * 0.001))

    rho = P / (R_AIR * T)
    a = math.sqrt(GAMMA * R_AIR * T)
    mu = 1.458e-6 * T**1.5 / (T + 110.4)
    return {"T": T, "P": P, "rho": rho, "a": a, "mu": mu}


def classify_mesh_case(filename: str) -> Tuple[str | None, str]:
    low = filename.lower()
    if "nuri" in low:
        return "누리호 (KSLV-II)", "#29B6F6"
    if "taurus" in low or "hammerhead" in low:
        return "타우러스 2210", "#FF7043"
    if "falcon" in low:
        return "팰컨 9 (Block 5)", "#66BB6A"
    return None, "#B0BEC5"


def npz_is_mesh(path: Path) -> bool:
    try:
        with np.load(path, allow_pickle=False) as data:
            needed = {"nodes", "quad_cells", "tri_cells", "face_nodes", "face_tag"}
            return needed.issubset(set(data.files))
    except Exception:
        return False


def discover_mesh_cases(workdir: Path) -> Dict[str, MeshCase]:
    cases: Dict[str, MeshCase] = {}
    candidates: Dict[str, Tuple[float, Path, str]] = {}
    for path in workdir.glob("*.npz"):
        if not npz_is_mesh(path):
            continue
        name, color = classify_mesh_case(path.name)
        if name is None:
            continue
        mtime = path.stat().st_mtime
        prev = candidates.get(name)
        if prev is None or mtime > prev[0]:
            candidates[name] = (mtime, path, color)

    for name, (_, path, color) in candidates.items():
        cases[name] = MeshCase(name=name, path=str(path), color=color)
    return cases


def polygon_metrics(poly_xy: np.ndarray) -> Tuple[float, float, float]:
    x = poly_xy[:, 0]
    y = poly_xy[:, 1]
    x2 = np.roll(x, -1)
    y2 = np.roll(y, -1)
    cross = x * y2 - x2 * y
    area_signed = 0.5 * np.sum(cross)
    if abs(area_signed) < EPS:
        center = np.mean(poly_xy, axis=0)
        return center[0], center[1], 0.0
    cx = np.sum((x + x2) * cross) / (6.0 * area_signed)
    cy = np.sum((y + y2) * cross) / (6.0 * area_signed)
    return cx, cy, area_signed


def point_segment_distance(points: np.ndarray, seg_a: np.ndarray, seg_b: np.ndarray) -> np.ndarray:
    ab = seg_b - seg_a
    denom = np.dot(ab, ab) + EPS
    t = np.clip(((points - seg_a) @ ab) / denom, 0.0, 1.0)
    proj = seg_a[None, :] + t[:, None] * ab[None, :]
    return np.sqrt(np.sum((points - proj) ** 2, axis=1))


def compute_wall_distance(centers: np.ndarray, body_segments: np.ndarray) -> np.ndarray:
    dist = np.full(len(centers), np.inf, dtype=np.float64)
    seg_a = body_segments[:, 0, :]
    seg_b = body_segments[:, 1, :]
    chunk = 128
    for start in range(0, len(seg_a), chunk):
        a = seg_a[start : start + chunk]
        b = seg_b[start : start + chunk]
        local = np.full(len(centers), np.inf, dtype=np.float64)
        for sa, sb in zip(a, b):
            local = np.minimum(local, point_segment_distance(centers, sa, sb))
        dist = np.minimum(dist, local)
    return np.maximum(dist, 1e-6)


@st.cache_resource(show_spinner=False)
def load_mesh(path: str, case_name: str) -> MeshData:
    with np.load(path, allow_pickle=False) as data:
        nodes = data["nodes"].astype(np.float64)
        quad_cells = data["quad_cells"].astype(np.int32)
        tri_cells = data["tri_cells"].astype(np.int32)
        face_nodes = data["face_nodes"].astype(np.float64)
        face_tag = data["face_tag"].astype(np.int8)

    cell_nodes: List[np.ndarray] = [row.copy() for row in quad_cells] + [row.copy() for row in tri_cells]
    cell_types = np.concatenate(
        [np.full(len(quad_cells), 4, dtype=np.int8), np.full(len(tri_cells), 3, dtype=np.int8)]
    )
    n_cells = len(cell_nodes)
    centers = np.zeros((n_cells, 2), dtype=np.float64)
    area = np.zeros(n_cells, dtype=np.float64)
    orient = np.ones(n_cells, dtype=np.int8)
    for i, cnodes in enumerate(cell_nodes):
        cx, cr, a_signed = polygon_metrics(nodes[cnodes])
        centers[i] = [cx, cr]
        area[i] = abs(a_signed)
        orient[i] = 1 if a_signed >= 0.0 else -1

    volume = area * 2.0 * math.pi * np.maximum(centers[:, 1], 1e-6)

    coord_to_node: Dict[Tuple[float, float], int] = {}
    for idx, (x, r) in enumerate(nodes):
        coord_to_node[(round(float(x), 10), round(float(r), 10))] = idx

    boundary_tags: Dict[Tuple[int, int], int] = {}
    for seg, tag in zip(face_nodes, face_tag):
        a = coord_to_node.get((round(float(seg[0, 0]), 10), round(float(seg[0, 1]), 10)))
        b = coord_to_node.get((round(float(seg[1, 0]), 10), round(float(seg[1, 1]), 10)))
        if a is None or b is None:
            continue
        boundary_tags[(min(a, b), max(a, b))] = int(tag)

    edge_map: Dict[Tuple[int, int], List[Tuple[int, Tuple[int, int]]]] = {}
    for icell, cnodes in enumerate(cell_nodes):
        nloc = len(cnodes)
        for j in range(nloc):
            a = int(cnodes[j])
            b = int(cnodes[(j + 1) % nloc])
            key = (min(a, b), max(a, b))
            edge_map.setdefault(key, []).append((icell, (a, b)))

    faces_left = []
    faces_right = []
    face_node_a = []
    face_node_b = []
    face_center = []
    face_normal = []
    face_length = []
    face_area = []
    face_tags = []
    cell_faces: List[List[int]] = [[] for _ in range(n_cells)]

    for key, entries in edge_map.items():
        left, directed = entries[0]
        right = entries[1][0] if len(entries) == 2 else -1
        a, b = directed
        pa = nodes[a]
        pb = nodes[b]
        edge = pb - pa
        length = float(np.linalg.norm(edge))
        if length < EPS:
            continue
        if orient[left] > 0:
            normal = np.array([edge[1], -edge[0]], dtype=np.float64) / length
        else:
            normal = np.array([-edge[1], edge[0]], dtype=np.float64) / length
        midpoint = 0.5 * (pa + pb)
        if right >= 0:
            dc = centers[right] - centers[left]
            if float(np.dot(normal, dc)) < 0.0:
                normal *= -1.0
        else:
            dc = midpoint - centers[left]
            if float(np.dot(normal, dc)) < 0.0:
                normal *= -1.0
        area_face = length * 2.0 * math.pi * max(float(midpoint[1]), 1e-6)
        tag = boundary_tags.get(key, 0 if right >= 0 else 5)

        idx = len(faces_left)
        faces_left.append(left)
        faces_right.append(right)
        face_node_a.append(a)
        face_node_b.append(b)
        face_center.append(midpoint)
        face_normal.append(normal)
        face_length.append(length)
        face_area.append(area_face)
        face_tags.append(tag)
        cell_faces[left].append(idx)
        if right >= 0:
            cell_faces[right].append(idx)

    faces_left_arr = np.array(faces_left, dtype=np.int32)
    faces_right_arr = np.array(faces_right, dtype=np.int32)
    face_node_a_arr = np.array(face_node_a, dtype=np.int32)
    face_node_b_arr = np.array(face_node_b, dtype=np.int32)
    face_center_arr = np.array(face_center, dtype=np.float64)
    face_normal_arr = np.array(face_normal, dtype=np.float64)
    face_length_arr = np.array(face_length, dtype=np.float64)
    face_area_arr = np.array(face_area, dtype=np.float64)
    face_tags_arr = np.array(face_tags, dtype=np.int8)

    body_segments = []
    for a, b, tag in zip(face_node_a_arr, face_node_b_arr, face_tags_arr):
        if tag == 1:
            body_segments.append([nodes[a], nodes[b]])
    body_segments_arr = np.array(body_segments, dtype=np.float64)
    profile_points = body_segments_arr.reshape(-1, 2)
    order = np.argsort(profile_points[:, 0])
    profile_points = profile_points[order]
    _, uniq = np.unique(np.round(profile_points, 10), axis=0, return_index=True)
    profile_points = profile_points[np.sort(uniq)]

    wall_distance = compute_wall_distance(centers, body_segments_arr)
    r_ref = float(np.max(profile_points[:, 1]))
    length_ref = float(np.max(profile_points[:, 0]) - np.min(profile_points[:, 0]))
    ref_area = math.pi * r_ref**2

    return MeshData(
        name=case_name,
        path=path,
        nodes=nodes,
        cell_nodes=cell_nodes,
        cell_types=cell_types,
        cell_centers=centers,
        cell_area=area,
        cell_volume=volume,
        cell_orientation=orient,
        faces_left=faces_left_arr,
        faces_right=faces_right_arr,
        face_node_a=face_node_a_arr,
        face_node_b=face_node_b_arr,
        face_center=face_center_arr,
        face_normal=face_normal_arr,
        face_length=face_length_arr,
        face_area=face_area_arr,
        face_tag=face_tags_arr,
        cell_faces=cell_faces,
        wall_distance=wall_distance,
        profile_x=profile_points[:, 0],
        profile_r=profile_points[:, 1],
        r_ref=r_ref,
        length_ref=length_ref,
        ref_area=ref_area,
        body_segments=body_segments_arr,
    )


def freestream_state(mach: float, altitude: float, turb_intensity: float, turb_visc_ratio: float) -> Tuple[np.ndarray, Dict[str, float]]:
    atm = isa_atmosphere(altitude)
    a = atm["a"]
    u = mach * a
    v = 0.0
    rho = atm["rho"]
    p = atm["P"]
    T = atm["T"]
    mu = atm["mu"]
    k = max(1.5 * (u * turb_intensity) ** 2, 1e-8)
    omega = max(rho * k / (mu * turb_visc_ratio + EPS), 1.0)
    e = p / ((GAMMA - 1.0) * rho)
    E = e + 0.5 * (u * u + v * v) + k
    U = np.array([rho, rho * u, rho * v, rho * E, rho * k, rho * omega], dtype=np.float64)
    return U, {"rho": rho, "u": u, "v": v, "p": p, "T": T, "a": a, "mu": mu, "k": k, "omega": omega}


def cons_to_prim(U: np.ndarray) -> Dict[str, np.ndarray]:
    rho = np.maximum(U[:, 0], 1e-8)
    u = U[:, 1] / rho
    v = U[:, 2] / rho
    k = np.maximum(U[:, 4] / rho, 1e-8)
    omega = np.maximum(U[:, 5] / rho, 1.0)
    E = U[:, 3] / rho
    eint = np.maximum(E - 0.5 * (u * u + v * v) - k, 1e-6)
    p = np.maximum((GAMMA - 1.0) * rho * eint, 1.0)
    T = p / (rho * R_AIR)
    a = np.sqrt(np.maximum(GAMMA * R_AIR * T, 1.0))
    H = E + p / rho
    return {"rho": rho, "u": u, "v": v, "p": p, "T": T, "a": a, "k": k, "omega": omega, "E": E, "H": H}


def sutherland_mu(T: np.ndarray) -> np.ndarray:
    return 1.458e-6 * np.maximum(T, 50.0) ** 1.5 / (np.maximum(T, 50.0) + 110.4)


def primitive_matrix(prim: Dict[str, np.ndarray]) -> np.ndarray:
    return np.column_stack([prim["rho"], prim["u"], prim["v"], prim["p"], prim["T"], prim["k"], prim["omega"]])


def compute_gradients(mesh: MeshData, phi: np.ndarray) -> np.ndarray:
    n_cells, n_var = phi.shape
    grad = np.zeros((n_cells, n_var, 2), dtype=np.float64)
    for iface in range(len(mesh.faces_left)):
        left = mesh.faces_left[iface]
        right = mesh.faces_right[iface]
        nvec = mesh.face_normal[iface]
        area = mesh.face_area[iface]
        if right >= 0:
            phi_face = 0.5 * (phi[left] + phi[right])
            grad[left] += phi_face[:, None] * nvec[None, :] * area
            grad[right] -= phi_face[:, None] * nvec[None, :] * area
        else:
            phi_face = phi[left]
            grad[left] += phi_face[:, None] * nvec[None, :] * area
    grad /= mesh.cell_volume[:, None, None] + EPS
    return grad


def sst_closure(mesh: MeshData, prim: Dict[str, np.ndarray], grad: np.ndarray) -> Dict[str, np.ndarray]:
    rho = prim["rho"]
    T = prim["T"]
    k = prim["k"]
    omega = prim["omega"]
    u = prim["u"]
    v = prim["v"]

    mu_l = sutherland_mu(T)
    nu = mu_l / rho

    du_dx = grad[:, 1, 0]
    du_dr = grad[:, 1, 1]
    dv_dx = grad[:, 2, 0]
    dv_dr = grad[:, 2, 1]
    dk_dx = grad[:, 5, 0]
    dk_dr = grad[:, 5, 1]
    dw_dx = grad[:, 6, 0]
    dw_dr = grad[:, 6, 1]
    y = mesh.wall_distance

    s2 = 2.0 * du_dx**2 + 2.0 * dv_dr**2 + (du_dr + dv_dx) ** 2
    S = np.sqrt(np.maximum(s2, 1e-12))

    sigma_k1 = 0.85
    sigma_k2 = 1.00
    sigma_w1 = 0.50
    sigma_w2 = 0.856
    beta1 = 0.075
    beta2 = 0.0828
    beta_star = 0.09
    alpha1 = 5.0 / 9.0
    alpha2 = 0.44
    a1 = 0.31

    gradk_dot_gradw = dk_dx * dw_dx + dk_dr * dw_dr
    cd_kw = np.maximum(2.0 * rho * sigma_w2 * gradk_dot_gradw / np.maximum(omega, 1.0), 1e-12)
    arg1_a = np.sqrt(np.maximum(k, 0.0)) / np.maximum(beta_star * omega * y, 1e-9)
    arg1_b = 500.0 * nu / np.maximum(y * y * omega, 1e-9)
    arg1_c = 4.0 * rho * sigma_w2 * k / np.maximum(cd_kw * y * y, 1e-9)
    arg1 = np.minimum(np.maximum(arg1_a, arg1_b), arg1_c)
    F1 = np.tanh(arg1**4)

    arg2 = np.maximum(2.0 * np.sqrt(np.maximum(k, 0.0)) / np.maximum(beta_star * omega * y, 1e-9), arg1_b)
    F2 = np.tanh(arg2**2)

    sigma_k = F1 * sigma_k1 + (1.0 - F1) * sigma_k2
    sigma_w = F1 * sigma_w1 + (1.0 - F1) * sigma_w2
    alpha = F1 * alpha1 + (1.0 - F1) * alpha2
    beta = F1 * beta1 + (1.0 - F1) * beta2

    mu_t = rho * a1 * np.maximum(k, 0.0) / np.maximum(a1 * omega, S * F2 + 1e-12)
    mu_t = np.clip(mu_t, 0.0, 5000.0 * mu_l)

    Pk = np.minimum(mu_t * s2, 20.0 * beta_star * rho * k * omega)
    src_k = Pk - beta_star * rho * k * omega
    src_w = alpha * rho * s2 - beta * rho * omega**2
    src_w += 2.0 * (1.0 - F1) * rho * sigma_w2 * gradk_dot_gradw / np.maximum(omega, 1.0)

    cp = GAMMA * R_AIR / (GAMMA - 1.0)
    kappa_eff = cp * (mu_l / PR_LAM + mu_t / PR_T)

    return {
        "mu_l": mu_l,
        "mu_t": mu_t,
        "mu_eff": mu_l + mu_t,
        "sigma_k": sigma_k,
        "sigma_w": sigma_w,
        "kappa_eff": kappa_eff,
        "S": S,
        "src_k": src_k,
        "src_w": src_w,
    }


def ausm_plus_flux(UL: np.ndarray, UR: np.ndarray, normal: np.ndarray) -> Tuple[np.ndarray, float]:
    ULm = UL[None, :]
    URm = UR[None, :]
    pL = cons_to_prim(ULm)
    pR = cons_to_prim(URm)

    rhoL = pL["rho"][0]
    rhoR = pR["rho"][0]
    uL = pL["u"][0]
    uR = pR["u"][0]
    vL = pL["v"][0]
    vR = pR["v"][0]
    p_left = pL["p"][0]
    p_right = pR["p"][0]
    aL = pL["a"][0]
    aR = pR["a"][0]
    HL = pL["H"][0]
    HR = pR["H"][0]

    unL = uL * normal[0] + vL * normal[1]
    unR = uR * normal[0] + vR * normal[1]
    a_face = max(0.5 * (aL + aR), 1.0)
    ML = unL / a_face
    MR = unR / a_face
    beta = 0.125
    alpha = 3.0 / 16.0

    def m4_plus(M):
        if abs(M) >= 1.0:
            return 0.5 * (M + abs(M))
        return 0.25 * (M + 1.0) ** 2 + beta * (M * M - 1.0) ** 2

    def m4_minus(M):
        if abs(M) >= 1.0:
            return 0.5 * (M - abs(M))
        return -0.25 * (M - 1.0) ** 2 - beta * (M * M - 1.0) ** 2

    def p5_plus(M):
        if abs(M) >= 1.0:
            return 0.5 * (1.0 + np.sign(M))
        return 0.25 * (M + 1.0) ** 2 * (2.0 - M) + alpha * M * (M * M - 1.0) ** 2

    def p5_minus(M):
        if abs(M) >= 1.0:
            return 0.5 * (1.0 - np.sign(M))
        return 0.25 * (M - 1.0) ** 2 * (2.0 + M) - alpha * M * (M * M - 1.0) ** 2

    mdot = a_face * (rhoL * m4_plus(ML) + rhoR * m4_minus(MR))
    p_int = p_left * p5_plus(ML) + p_right * p5_minus(MR)

    if mdot >= 0.0:
        rho = rhoL
        u = uL
        v = vL
        H = HL
        k = pL["k"][0]
        omega = pL["omega"][0]
    else:
        rho = rhoR
        u = uR
        v = vR
        H = HR
        k = pR["k"][0]
        omega = pR["omega"][0]

    flux = np.array(
        [
            mdot,
            mdot * u + p_int * normal[0],
            mdot * v + p_int * normal[1],
            mdot * H,
            mdot * k,
            mdot * omega,
        ],
        dtype=np.float64,
    )
    lam = abs(unL) + abs(unR) + aL + aR
    return flux, lam


def boundary_ghost_state(mesh: MeshData, iface: int, UL: np.ndarray, U_inf: np.ndarray) -> np.ndarray:
    tag = int(mesh.face_tag[iface])
    prim_l = cons_to_prim(UL[None, :])
    rho = prim_l["rho"][0]
    p = prim_l["p"][0]
    T = prim_l["T"][0]
    u = prim_l["u"][0]
    v = prim_l["v"][0]
    k = prim_l["k"][0]
    omega = prim_l["omega"][0]
    n = mesh.face_normal[iface]

    if tag in (3, 4, 5):
        return U_inf.copy()

    if tag == 2:
        vel = np.array([u, v], dtype=np.float64)
        vel_g = vel - 2.0 * np.dot(vel, n) * n
        e = p / ((GAMMA - 1.0) * rho)
        E = e + 0.5 * np.dot(vel_g, vel_g) + k
        return np.array([rho, rho * vel_g[0], rho * vel_g[1], rho * E, rho * k, rho * omega], dtype=np.float64)

    if tag == 1:
        left = mesh.faces_left[iface]
        y = mesh.wall_distance[left]
        mu = sutherland_mu(np.array([T]))[0]
        beta1 = 0.075
        omega_wall = max(60.0 * mu / (rho * beta1 * y * y + EPS), 10.0)
        vel_g = np.array([-u, -v], dtype=np.float64)
        k_g = 1e-8
        e = p / ((GAMMA - 1.0) * rho)
        E = e + 0.5 * np.dot(vel_g, vel_g) + k_g
        return np.array([rho, rho * vel_g[0], rho * vel_g[1], rho * E, rho * k_g, rho * omega_wall], dtype=np.float64)

    return U_inf.copy()


def viscous_flux(
    mesh: MeshData,
    iface: int,
    prim: Dict[str, np.ndarray],
    grad: np.ndarray,
    closure: Dict[str, np.ndarray],
) -> np.ndarray:
    left = mesh.faces_left[iface]
    right = mesh.faces_right[iface]
    n = mesh.face_normal[iface]
    rc = max(mesh.face_center[iface, 1], 1e-6)

    if right >= 0:
        grad_face = 0.5 * (grad[left] + grad[right])
        u = 0.5 * (prim["u"][left] + prim["u"][right])
        v = 0.5 * (prim["v"][left] + prim["v"][right])
        mu = 0.5 * (closure["mu_eff"][left] + closure["mu_eff"][right])
        kappa = 0.5 * (closure["kappa_eff"][left] + closure["kappa_eff"][right])
        gamma_k = 0.5 * (
            (closure["mu_l"][left] + closure["mu_t"][left] / closure["sigma_k"][left])
            + (closure["mu_l"][right] + closure["mu_t"][right] / closure["sigma_k"][right])
        )
        gamma_w = 0.5 * (
            (closure["mu_l"][left] + closure["mu_t"][left] / closure["sigma_w"][left])
            + (closure["mu_l"][right] + closure["mu_t"][right] / closure["sigma_w"][right])
        )
    else:
        grad_face = grad[left]
        u = prim["u"][left]
        v = prim["v"][left]
        mu = closure["mu_eff"][left]
        kappa = closure["kappa_eff"][left]
        gamma_k = closure["mu_l"][left] + closure["mu_t"][left] / closure["sigma_k"][left]
        gamma_w = closure["mu_l"][left] + closure["mu_t"][left] / closure["sigma_w"][left]

    du_dx = grad_face[1, 0]
    du_dr = grad_face[1, 1]
    dv_dx = grad_face[2, 0]
    dv_dr = grad_face[2, 1]
    dT_dx = grad_face[4, 0]
    dT_dr = grad_face[4, 1]
    dk_dx = grad_face[5, 0]
    dk_dr = grad_face[5, 1]
    dw_dx = grad_face[6, 0]
    dw_dr = grad_face[6, 1]

    div_v = du_dx + dv_dr + v / rc
    tau_xx = 2.0 * mu * du_dx - (2.0 / 3.0) * mu * div_v
    tau_rr = 2.0 * mu * dv_dr - (2.0 / 3.0) * mu * div_v
    tau_xr = mu * (du_dr + dv_dx)
    qx = -kappa * dT_dx
    qr = -kappa * dT_dr

    flux = np.zeros(6, dtype=np.float64)
    flux[1] = tau_xx * n[0] + tau_xr * n[1]
    flux[2] = tau_xr * n[0] + tau_rr * n[1]
    flux[3] = (u * tau_xx + v * tau_xr + qx) * n[0] + (u * tau_xr + v * tau_rr + qr) * n[1]
    flux[4] = gamma_k * (dk_dx * n[0] + dk_dr * n[1])
    flux[5] = gamma_w * (dw_dx * n[0] + dw_dr * n[1])
    return flux


def compute_residual(mesh: MeshData, U: np.ndarray, U_inf: np.ndarray) -> Tuple[np.ndarray, np.ndarray, np.ndarray, Dict[str, np.ndarray]]:
    prim = cons_to_prim(U)
    phi = primitive_matrix(prim)
    grad = compute_gradients(mesh, phi)
    closure = sst_closure(mesh, prim, grad)

    res = np.zeros_like(U)
    diag_spec = np.zeros(len(mesh.cell_nodes), dtype=np.float64)
    face_spec = np.zeros(len(mesh.faces_left), dtype=np.float64)

    for iface in range(len(mesh.faces_left)):
        left = mesh.faces_left[iface]
        right = mesh.faces_right[iface]
        UL = U[left]
        UR = U[right] if right >= 0 else boundary_ghost_state(mesh, iface, UL, U_inf)
        flux_c, lam = ausm_plus_flux(UL, UR, mesh.face_normal[iface])
        flux_v = viscous_flux(mesh, iface, prim, grad, closure)
        total_flux = (flux_c - flux_v) * mesh.face_area[iface]
        res[left] += total_flux
        diag_spec[left] += lam * mesh.face_area[iface]
        if right >= 0:
            res[right] -= total_flux
            diag_spec[right] += lam * mesh.face_area[iface]
        face_spec[iface] = lam * mesh.face_area[iface]

    src = np.zeros_like(U)
    src[:, 4] = closure["src_k"]
    src[:, 5] = closure["src_w"]
    res -= src * mesh.cell_volume[:, None]

    return res, diag_spec, face_spec, {"prim": prim, "grad": grad, "closure": closure}


def lusgs_step(
    mesh: MeshData,
    U: np.ndarray,
    res: np.ndarray,
    diag_spec: np.ndarray,
    face_spec: np.ndarray,
    cfl: float,
) -> np.ndarray:
    order = np.argsort(mesh.cell_centers[:, 0])
    rank = np.empty_like(order)
    rank[order] = np.arange(len(order))

    dt = cfl * mesh.cell_volume / (diag_spec + EPS)
    diag = mesh.cell_volume / (dt + EPS) + 0.5 * diag_spec + 1e-8
    delta = np.zeros_like(U)

    for i in order:
        corr = np.zeros(U.shape[1], dtype=np.float64)
        for iface in mesh.cell_faces[i]:
            l = mesh.faces_left[iface]
            r = mesh.faces_right[iface]
            j = r if l == i else l
            if j < 0 or rank[j] >= rank[i]:
                continue
            corr += 0.25 * face_spec[iface] * delta[j]
        delta[i] = (-res[i] - corr) / diag[i]

    for i in order[::-1]:
        corr = np.zeros(U.shape[1], dtype=np.float64)
        for iface in mesh.cell_faces[i]:
            l = mesh.faces_left[iface]
            r = mesh.faces_right[iface]
            j = r if l == i else l
            if j < 0 or rank[j] <= rank[i]:
                continue
            corr += 0.25 * face_spec[iface] * delta[j]
        delta[i] = delta[i] - corr / diag[i]

    return delta


def enforce_physical_bounds(U: np.ndarray) -> np.ndarray:
    prim = cons_to_prim(U)
    rho = np.maximum(prim["rho"], 1e-8)
    u = prim["u"]
    v = prim["v"]
    p = np.maximum(prim["p"], 100.0)
    k = np.maximum(prim["k"], 1e-8)
    omega = np.maximum(prim["omega"], 1.0)
    e = p / ((GAMMA - 1.0) * rho)
    E = e + 0.5 * (u * u + v * v) + k
    bounded = np.column_stack([rho, rho * u, rho * v, rho * E, rho * k, rho * omega])
    return bounded


def force_coefficients(mesh: MeshData, prim: Dict[str, np.ndarray], grad: np.ndarray, closure: Dict[str, np.ndarray], freestream: Dict[str, float], alpha_proxy_deg: float) -> Dict[str, float]:
    q_inf = 0.5 * freestream["rho"] * freestream["u"] ** 2
    area_ref = mesh.ref_area
    fx_p = 0.0
    fr_p = 0.0
    fx_v = 0.0
    fr_v = 0.0

    for iface, tag in enumerate(mesh.face_tag):
        if int(tag) != 1:
            continue
        left = mesh.faces_left[iface]
        n = mesh.face_normal[iface]
        af = mesh.face_area[iface]
        p = prim["p"][left]
        visc = viscous_flux(mesh, iface, prim, grad, closure)
        fp = -p * n * af
        fv = np.array([visc[1], visc[2]]) * af
        fx_p += fp[0]
        fr_p += fp[1]
        fx_v += fv[0]
        fr_v += fv[1]

    fx_total = fx_p + fx_v
    fr_total = fr_p + fr_v
    cd_pressure = fx_p / (q_inf * area_ref + EPS)
    cd_viscous = fx_v / (q_inf * area_ref + EPS)
    cd_total = fx_total / (q_inf * area_ref + EPS)

    # Axisymmetric single-body mesh cannot directly resolve off-axis load.
    # Keep streamlit outputs by combining radial proxy and legacy slender-body relation.
    alpha = math.radians(alpha_proxy_deg)
    slender_proxy = 2.0 * alpha * (1.0 + 1.0 / max(2.0 * mesh.length_ref / (2.0 * mesh.r_ref + EPS), 1.0))
    cn = 0.5 * abs(fr_total) / (q_inf * area_ref + EPS) + 0.5 * slender_proxy
    x_cp = 0.35 * mesh.length_ref
    x_cg = 0.45 * mesh.length_ref
    cm = cn * (x_cg - x_cp) / (2.0 * mesh.r_ref + EPS)

    return {
        "CD_total": cd_total,
        "CD_pressure": cd_pressure,
        "CD_viscous": cd_viscous,
        "CD_turbulent": max(cd_total - cd_pressure - cd_viscous, 0.0),
        "CN": cn,
        "Cm": cm,
    }


def solve_case(
    mesh: MeshData,
    cfg: SolverConfig,
    progress_callback: Callable[[str, float], None] | None = None,
) -> SolverResult:
    U_inf, freestream = freestream_state(cfg.mach, cfg.altitude, cfg.turbulence_intensity, cfg.turb_visc_ratio)
    U = np.tile(U_inf, (len(mesh.cell_nodes), 1))

    residual_history: List[float] = []
    t0 = time.perf_counter()
    last_aux = None
    for it in range(cfg.max_iter):
        res, diag_spec, face_spec, aux = compute_residual(mesh, U, U_inf)
        last_aux = aux
        rnorm = float(np.linalg.norm(res[:, 0]) / math.sqrt(len(mesh.cell_nodes)))
        residual_history.append(rnorm)
        if progress_callback is not None:
            progress_callback(
                f"[{mesh.name}] LU-SGS {it + 1}/{cfg.max_iter} | continuity residual = {rnorm:.3e}",
                (it + 1) / max(cfg.max_iter, 1),
            )
        if rnorm < cfg.tol:
            break
        dU = lusgs_step(mesh, U, res, diag_spec, face_spec, cfg.cfl)
        U = enforce_physical_bounds(U + dU)

    runtime_s = time.perf_counter() - t0
    if last_aux is None:
        _, _, _, last_aux = compute_residual(mesh, U, U_inf)

    coeffs = force_coefficients(mesh, last_aux["prim"], last_aux["grad"], last_aux["closure"], freestream, cfg.alpha_proxy_deg)
    return SolverResult(
        U=U,
        primitive=last_aux["prim"],
        residual_history=residual_history,
        runtime_s=runtime_s,
        coeffs=coeffs,
        mesh_points=len(mesh.nodes),
        n_cells=len(mesh.cell_nodes),
        n_faces=len(mesh.faces_left),
    )


def run_mach_sweep(
    mesh: MeshData,
    mach_arr: np.ndarray,
    altitude: float,
    base_cfg: SolverConfig,
    progress_callback: Callable[[str, float], None] | None = None,
) -> Dict[str, List[float]]:
    cds = []
    cns = []
    cms = []
    runtimes = []
    for idx, M in enumerate(mach_arr):
        cfg = SolverConfig(
            mach=float(M),
            altitude=altitude,
            cfl=base_cfg.cfl,
            max_iter=max(4, min(base_cfg.max_iter, 8)),
            tol=base_cfg.tol,
            turbulence_intensity=base_cfg.turbulence_intensity,
            turb_visc_ratio=base_cfg.turb_visc_ratio,
            alpha_proxy_deg=base_cfg.alpha_proxy_deg,
        )
        if progress_callback is not None:
            progress_callback(
                f"[{mesh.name}] Mach sweep {idx + 1}/{len(mach_arr)} | M = {M:.2f}",
                (idx + 1) / max(len(mach_arr), 1),
            )
        result = solve_case(mesh, cfg)
        cds.append(result.coeffs["CD_total"])
        cns.append(result.coeffs["CN"])
        cms.append(result.coeffs["Cm"])
        runtimes.append(result.runtime_s)
    return {"cd": cds, "cn": cns, "cm": cms, "runtime": runtimes}


