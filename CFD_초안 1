def estimate_runtime_seconds(n_cells: int, max_iter: int, n_mach: int, n_cases: int) -> float:
    # Empirical first-pass estimate from local Python implementation on current mesh scale.
    sec_per_cell_iter = 3.4e-4
    single = n_cells * max_iter * sec_per_cell_iter
    sweep_factor = max(1, n_mach)
    return n_cases * (single + 0.6 * single * sweep_factor / max(max_iter, 1))


